# Aura+ Environment Configuration
# Primary: AWS Bedrock Runtime Credentials
# If left blank, Aura+ runs seamlessly in Autonomous Developer Simulator Mode!

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Automatic Multi-Model Quota Fallback Configuration
# If the primary model hits quota / rate limits / throttling, Aura+ will automatically
# cascade through alternative models:
# 1. anthropic.claude-3-5-sonnet-20240620-v1:0 (Claude 3.5 Sonnet)
# 2. amazon.nova-pro-v1:0 (Amazon Nova Pro)
# 3. anthropic.claude-3-haiku-20240307-v1:0 (Claude 3 Haiku)
# 4. amazon.nova-lite-v1:0 (Amazon Nova Lite)
# 5. meta.llama3-3-70b-instruct-v1:0 (Meta Llama 3.3)

# Optional External Fallback Models (Used if Bedrock quota runs out or keys provided)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Server Port
PORT=3000
